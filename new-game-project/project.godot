; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false
compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Anemoia"
run/main_scene="uid://bxfh01tfrsiym"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlayerStats="*res://Scripts/Singleton/Player_stats.gd"
SignalBus="*res://Scripts/Singleton/Signal_bus.gd"
ConfigFileHandler="*res://Scripts/Singleton/ConfigFileHandler.gd"
QuestHandler="*res://Scripts/Singleton/quest_handler.gd"
UI="*res://UI/UI.gd"
AudioManager="*res://System/Sound/audio_manager.tscn"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"TestTimeline": "res://Dialogue/Timelines/TestTimeline.dtl"
}
layout/style_directory={}
layout/style_list=["res://Dialogue/Styles/NormalDialogue.tres"]
layout/default_style="res://Dialogue/Styles/NormalDialogue.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="New Game Project"

[editor_plugins]

enabled=PackedStringArray("res://addons/ez_dialogue/plugin.cfg", "res://addons/finite_state_machine/plugin.cfg")

[global_group]

ToBeSaved="For SaveData"
TalkingTriggers=""
Player=""
Enemies=""
HUD=""
World="This is the physical place where everything exists"

